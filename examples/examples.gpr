with "config/humanize_examples_config.gpr";

project Examples is

   for Source_Dirs use (".", "config");
   for Object_Dir use "obj/" & Humanize_Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("humanize_demo.adb",
      "parse_demo.adb",
      "bounded_demo.adb",
      "color_demo.adb",
      "domain_demo.adb",
      "system_status_demo.adb",
      "ui_labels_demo.adb",
      "security_data_demo.adb",
      "workflow_ops_demo.adb",
      "product_details_demo.adb",
      "public_surface_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Humanize_Examples_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;

end Examples;
