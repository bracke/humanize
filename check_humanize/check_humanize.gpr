with "config/check_humanize_config.gpr";

project Check_Humanize is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Humanize_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_humanize.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Humanize_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Check_Humanize;
